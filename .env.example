PEERFORA_HOST=127.0.0.1
PEERFORA_PORT=3000
PEERFORA_LOG=info
DATABASE_URL=postgresql://peerfora:replace-with-local-password@localhost:5432/peerfora
PEERFORA_PUBLIC_URL=http://localhost:3000
PEERFORA_ALLOWED_ORIGINS=http://localhost:3000
PEERFORA_REQUEST_TIMEOUT_SECONDS=30
PEERFORA_COOKIE_SECURE=false
# Set a base64-encoded 32-byte key from deployment secret management before using admin MFA.
PEERFORA_ADMIN_MFA_ENCRYPTION_KEY=
PEERFORA_AUTH_RATE_LIMIT_HASH_KEY=
PEERFORA_COUNTRY_POLICIES={}
PEERFORA_SMTP_HOST=
PEERFORA_SMTP_PORT=587
PEERFORA_SMTP_USERNAME=
PEERFORA_SMTP_PASSWORD=
PEERFORA_SMTP_FROM=
PEERFORA_GOOGLE_CLIENT_ID=
PEERFORA_GOOGLE_CLIENT_SECRET=
PEERFORA_GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/social/google/callback
PEERFORA_APPLE_CLIENT_ID=
PEERFORA_APPLE_CLIENT_SECRET=
PEERFORA_APPLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/social/apple/callback
