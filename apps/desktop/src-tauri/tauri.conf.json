{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Peerfora",
  "version": "0.1.0",
  "identifier": "com.peerfora.student.desktop",
  "build": {
    "beforeDevCommand": "trunk serve --address 127.0.0.1 --port 1420 --config ../frontend/Trunk.toml",
    "beforeBuildCommand": "trunk build --release --config ../frontend/Trunk.toml",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Peerfora",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' http://127.0.0.1:3000"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
